<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.0.197</domain>
        <domain includeSubdomains="true">192.168.1.33</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">pingdart.com</domain>
        <domain includeSubdomains="true">chat.pingdart.com</domain>
        <domain includeSubdomains="true">api.chat.pingdart.com</domain>
        <domain includeSubdomains="true">storage.pingdart.com</domain>
        <domain includeSubdomains="true">cloudapi.pingdart.com</domain>
    </domain-config>
</network-security-config>
