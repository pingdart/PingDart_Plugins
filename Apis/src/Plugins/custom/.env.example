# ==============================================================================
# PingDart Custom Plugin — Database Configuration (.env)
# Location: Apis/src/Plugins/custom/.env
#
# Optional: To connect to your own isolated local database during plugin development,
# copy this file to .env and configure below.
# When deployed live, leave unset to automatically use the live platform plugins DB (pingdart_plugins).
#
# Every table created by this plugin is automatically prefixed with custom_
# (e.g., custom_items)
# ==============================================================================

# PLUGIN_CUSTOM_DB_NAME=developer_local_db
# PLUGIN_CUSTOM_DB_USER=root
# PLUGIN_CUSTOM_DB_PASS=
# PLUGIN_CUSTOM_DB_HOST=127.0.0.1
# PLUGIN_CUSTOM_DB_PORT=3306
